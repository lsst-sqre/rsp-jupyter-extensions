#!/usr/bin/env python3
"""Wrap JupyterLab launch in respx mock."""

import json
import os
import sys
from pathlib import Path

import respx
from httpx import Response
from jupyterlab.labapp import main


@respx.mock
def _mock_discovery() -> None:
    disco = json.loads(
        (
            Path(__file__).parent.parent
            / "data"
            / "etc"
            / "nublado"
            / "discovery_v1.json"
        ).read_text()
    )
    url = os.environ.get("REPERTOIRE_BASE_URL")
    restore = False
    if url is None:
        restore = True
        url = "https://example.com/repertoire"
        os.environ["REPERTOIRE_BASE_URL"] = url
    mocked = respx.get(url + "/discovery")
    mocked.return_value = Response(200, json=disco)

    rc = main()
    if restore:
        del os.environ["REPERTOIRE_BASE_URL"]
    sys.exit(rc)


if __name__ == "__main__":
    _mock_discovery()
